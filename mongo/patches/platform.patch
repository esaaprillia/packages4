From: firmwarecostum <145313986+firmwarecostum@users.noreply.github.com>
Date: Fri, 8 May 2026 22:47:06 +0800
Subject: [PATCH] Update propagate_shell_environment.vars

---
 etc/scons/propagate_shell_environment.vars | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/etc/scons/propagate_shell_environment.vars b/etc/scons/propagate_shell_environment.vars
index 3f9eedb549444..f9c3731c7c6f9 100644
--- a/etc/scons/propagate_shell_environment.vars
+++ b/etc/scons/propagate_shell_environment.vars
@@ -3,4 +3,4 @@ import os
 # Causes SCons to import the parent environment into subordinate process execution. This
 # can lead to non-reproducible builds... use with caution.
 
-ENV=os.environ
+ENV=os.environ['PLATFORM']
