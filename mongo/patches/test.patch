         'CPPPATH': [
             '#src/third_party/cares/dist/include',
@@ -118,6 +117,11 @@ if not use_system_version_of_library('boost'):
         'CCFLAGS': ['$NOERROR_FOR_UNKNOWN_WARNING_OPTION_GEN'] if env.ToolchainIs('clang') else []
     }
 
