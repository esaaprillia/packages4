From d121e6c8139c7a2198b0d6f1cf44d977593c4c72 Mon Sep 17 00:00:00 2001
From: esaaprillia <esaapriliasalsabila@gmail.com>
Date: Tue, 27 Oct 2026 10:58:45 +0000
Subject: [PATCH] Update Cargo.toml

---
 Cargo.toml | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 0c7275bbe..9e72ab540 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -92,9 +92,9 @@ signal-neon-futures = { path = "rust/bridge/node/futures" }
 # Our forks of some dependencies, accessible as xxx_signal so that usages of them are obvious in source code. Crates
 # that want to use the real things can depend on those directly.
 
-boring-signal = { git = "https://github.com/signalapp/boring", tag = "signal-v5.2.0", package = "boring", default-features = false }
+boring-signal = { git = "https://github.com/esaapriliasalsabila/boring", tag = "signal-v5.2.0", package = "boring", default-features = false }
 spqr = { git = "https://github.com/signalapp/SparsePostQuantumRatchet.git", tag = "v1.6.0" }
-tokio-boring-signal = { git = "https://github.com/signalapp/boring", tag = "signal-v5.2.0", package = "tokio-boring" }
+tokio-boring-signal = { git = "https://github.com/esaapriliasalsabila/boring", tag = "signal-v5.2.0", package = "tokio-boring" }
 
 aes = "0.9.1"
 aes-gcm-siv = "0.12.0"
@@ -241,8 +241,8 @@ zeroize = "1.8.2"
 [patch.crates-io]
 # When building libsignal, just use our forks so we don't end up with two different versions of the libraries.
 
-boring = { git = 'https://github.com/signalapp/boring', tag = "signal-v5.2.0" }
-boring-sys = { git = 'https://github.com/signalapp/boring', tag = "signal-v5.2.0" }
+boring = { git = 'https://github.com/esaapriliasalsabila/boring', tag = "signal-v5.2.0" }
+boring-sys = { git = 'https://github.com/esaapriliasalsabila/boring', tag = "signal-v5.2.0" }
 
 [profile.dev.package.argon2]
 opt-level = 2 # libsignal-account-keys unit tests are too slow with an unoptimized argon2
