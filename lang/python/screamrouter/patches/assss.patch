From 8006035fa574692a92fe25969d48aaada6892636 Mon Sep 17 00:00:00 2001
From: esaaprillia <esaapriliasalsabila@gmail.com>
Date: Tue, 14 Oct 2025 13:48:53 +0800
Subject: [PATCH] Add files via upload

---
 build_system/builders/autotools_builder.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/build_system/builders/autotools_builder.py b/build_system/builders/autotools_builder.py
index 32ede9e..66aab13 100644
--- a/build_system/builders/autotools_builder.py
+++ b/build_system/builders/autotools_builder.py
@@ -53,15 +53,15 @@ def configure(self) -> bool:
             return False
         
         # Build configure command
-        configure_script_name = self.build_config.get("configure_script", "./configure")
+        configure_script_name = self.build_config.get("configure_script", "./configure --target=aarch64-openwrt-linux --host=aarch64-openwrt-linux --build=x86_64-pc-linux-gnu")
         cmd = [configure_script_name]
         
         # Add configure arguments (check if prefix is already included)
         configure_args = self.build_config.get("configure_args", [])
-        has_prefix = any("--prefix" in arg for arg in configure_args)
+        has_prefix = any("--target=aarch64-openwrt-linux --host=aarch64-openwrt-linux --build=x86_64-pc-linux-gnu --prefix" in arg for arg in configure_args)
         
         if not has_prefix:
-            cmd.append(f"--prefix={self.install_dir}")
+            cmd.append(f"--target=aarch64-openwrt-linux --host=aarch64-openwrt-linux --build=x86_64-pc-linux-gnu --prefix={self.install_dir}")
         
         for arg in configure_args:
             cmd.append(self.replace_variables(arg))
