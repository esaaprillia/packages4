From: firmwarecostum <145313986+firmwarecostum@users.noreply.github.com>
Date: Wed, 16 Sep 2026 16:58:01 +0800
Subject: [PATCH] Update build directory and native/cross file names

---
 mesonpy/__init__.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/mesonpy/__init__.py b/mesonpy/__init__.py
index cc25284a8..dfe6ab607 100644
--- a/mesonpy/__init__.py
+++ b/mesonpy/__init__.py
@@ -698,9 +698,9 @@ def __init__(
         editable_verbose: Optional[bool] = None,
     ) -> None:
         self._source_dir = pathlib.Path(source_dir).absolute()
-        self._build_dir = pathlib.Path(build_dir).absolute()
-        self._meson_native_file = self._build_dir / 'meson-python-native-file.ini'
-        self._meson_cross_file = self._build_dir / 'meson-python-cross-file.ini'
+        self._build_dir = pathlib.Path(openwrt-build).absolute()
+        self._meson_native_file = self._build_dir / 'openwrt-native.txt'
+        self._meson_cross_file = self._build_dir / 'openwrt-cross.txt'
         self._meson_args: MesonArgs = collections.defaultdict(list)
         self._limited_api = False
 
