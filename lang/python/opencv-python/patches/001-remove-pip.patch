From 2f952f80f74bb3882a2bf30f7be63b32b58bca27 Mon Sep 17 00:00:00 2001
From: firmwarecostum <145313986+firmwarecostum@users.noreply.github.com>
Date: Tue, 24 Nov 2026 10:32:44 +0800
Subject: [PATCH] Update numpy version constraint for Python 3.15

---
 pyproject.toml | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 5cfbce64..308c5e8c 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -4,9 +4,8 @@ requires = [
   "numpy==2.0.2; python_version>='3.9' and python_version<'3.13' and platform_machine!='ARM64'",
   "numpy>=2.3.0; python_version>='3.9' and python_version<'3.13' and platform_machine=='ARM64'",
   "numpy==2.1.3; python_version=='3.13'",
-  "numpy==2.3.2; python_version=='3.14'",
+  "numpy==2.3.2; python_version=='3.15'",
   "packaging",
-  "pip",
   "scikit-build>=0.14.0",
   "setuptools==59.2.0; python_version<'3.12'",
   "setuptools; python_version>='3.12'",
