     # Cython version bounds policy applies
-    "Cython>=3.0.8,<3.2.0",
+    "Cython",
     # The upper bound on pybind11 is pre-emptive only
     "pybind11>=2.13.2,<3.1.0",
     # The upper bound on pythran is pre-emptive only; 0.18.0
