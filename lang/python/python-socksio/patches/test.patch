From 7940105b4dedf88d60f20cb6ef70e9bb19effff9 Mon Sep 17 00:00:00 2001
From: firmwarecostum <145313986+firmwarecostum@users.noreply.github.com>
Date: Wed, 16 Sep 2026 05:50:47 +0800
Subject: [PATCH] Migrate pyproject.toml to new project format

---
 pyproject.toml | 21 +++++++++++++--------
 1 file changed, 13 insertions(+), 8 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 2856277..391973b 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,24 +1,29 @@
 [build-system]
-requires = ["flit_core >=2,<3"]
+requires = ["flit_core"]
 build-backend = "flit_core.buildapi"
 
-[tool.flit.metadata]
-module = "socksio"
-author = "Seth Michael Larson"
-author-email = "sethmichaellarson@gmail.com"
-home-page = "https://github.com/sethmlarson/socksio"
-requires-python=">=3.6"
-description-file="README.md"
+[project]
+name = "socksio"
+authors = [
+    { name = "Seth Michael Larson", email = "sethmichaellarson@gmail.com" },
+]
+readme = "README.md"
+requires-python = ">=3.6"
+dynamic = ["version", "description"]
 classifiers = [
     "License :: OSI Approved :: MIT License",
     "Programming Language :: Python :: 3.6",
     "Programming Language :: Python :: 3.7",
     "Programming Language :: Python :: 3.8",
     "Programming Language :: Python :: 3.9",
+    "Programming Language :: Python :: 3.10",
     "Programming Language :: Python :: 3 :: Only",
     "Topic :: Internet :: Proxy Servers",
 ]
 
+[project.urls]
+Homepage = "https://github.com/sethmlarson/socksio"
+
 [tool.isort]
 combine_as_imports = true
 force_grid_wrap = 0
