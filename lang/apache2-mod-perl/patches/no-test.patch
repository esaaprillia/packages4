From 09efc0aaaa9b17deeb35dad0d8b81fde24a6c251 Mon Sep 17 00:00:00 2001
From: firmwarecostum <145313986+firmwarecostum@users.noreply.github.com>
Date: Fri, 17 Apr 2026 23:49:12 +0800
Subject: [PATCH] Update Build.pm

---
 lib/Apache2/Build.pm | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/lib/Apache2/Build.pm b/lib/Apache2/Build.pm
index 19692a83..95d9a3d2 100644
--- a/lib/Apache2/Build.pm
+++ b/lib/Apache2/Build.pm
@@ -1883,7 +1883,6 @@ EOI
         $install .= <<'EOI';
 # install mod_perl.so
 	@$(MKPATH) $(DESTDIR)$(MODPERL_AP_LIBEXECDIR)
-	$(MODPERL_TEST_F) $(MODPERL_LIB_DSO) && \
 	$(MODPERL_CP) $(MODPERL_LIB_DSO) $(DESTDIR)$(MODPERL_AP_LIBEXECDIR)
 EOI
     }
@@ -1932,7 +1931,6 @@ EOI
         $install .= <<'EOI';
 # install mod_perl symbol file
 	@$(MKPATH) $(MODPERL_AP_LIBEXECDIR)
-	$(MODPERL_TEST_F) $(MODPERL_LIB_SYMBOLS) && \
 	$(MODPERL_CP) $(MODPERL_LIB_SYMBOLS) $(MODPERL_AP_LIBEXECDIR)
 EOI
     }
@@ -1953,7 +1951,6 @@ EOI
         $install .= <<'EOI';
 # install mod_perl.lib
 	@$(MKPATH) $(MODPERL_AP_LIBDIR)
-	$(MODPERL_TEST_F) $(MODPERL_LIB_LOCATION) && \
 	$(MODPERL_CP) $(MODPERL_LIB_LOCATION) $(MODPERL_AP_LIBDIR)
 EOI
     }

