       --test-dir ${CMAKE_CURRENT_SOURCE_DIR})
   endif()
 
new file mode 100644
index 000000000..fa45a679c
--- /dev/null
+++ b/glslc/src/build-version.inc
@@ -0,0 +1,3 @@
+"shaderc 2025.5"
+"SPIRV-Tools 1.4.335.0"
+"glslang 1.4.335.0"
