From 7a50d47ed1a083797305ffcc646800bc6a6d6894 Mon Sep 17 00:00:00 2001
From: Stephen WU <stephen0811@gmail.com>
Date: Sun, 26 Apr 2026 15:13:06 +0800
Subject: [PATCH 1/2] Build: Synchronize TensorFlow and XNNPACK tags for ARM
 build

---
 tensorflow/lite/CMakeLists.txt                    | 2 +-
 tensorflow/lite/tools/cmake/modules/xnnpack.cmake | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/tensorflow/lite/CMakeLists.txt b/tensorflow/lite/CMakeLists.txt
index 4cfd59427542a2..f85d2b91159a96 100644
--- a/tensorflow/lite/CMakeLists.txt
+++ b/tensorflow/lite/CMakeLists.txt
@@ -52,7 +52,7 @@ if(NOT TENSORFLOW_SOURCE_DIR)
     tensorflow
     GIT_REPOSITORY https://github.com/tensorflow/tensorflow.git
     # v2.21.0-rc0 has updated schema_generated.h file.
-    GIT_TAG v2.21.0-rc0
+    GIT_TAG fef4d514da6f7813f2bc61f209fb578630560b0c
     GIT_SHALLOW TRUE
     GIT_PROGRESS TRUE
     SOURCE_DIR ${CMAKE_CURRENT_BINARY_DIR}/tensorflow-src
diff --git a/tensorflow/lite/tools/cmake/modules/xnnpack.cmake b/tensorflow/lite/tools/cmake/modules/xnnpack.cmake
index c2717b7581f087..31c71a0be6580e 100644
--- a/tensorflow/lite/tools/cmake/modules/xnnpack.cmake
+++ b/tensorflow/lite/tools/cmake/modules/xnnpack.cmake
@@ -23,7 +23,7 @@ OverridableFetchContent_Declare(
   xnnpack
   GIT_REPOSITORY https://github.com/google/XNNPACK
   # Sync with tensorflow/workspace2.bzl
-  GIT_TAG bf362487d3c00ed7040a0c9c4b885f2ba20a6c45
+  GIT_TAG 1c5800aea5fca56cdb50cf5f8bd761c7b6dd0ee4
   GIT_PROGRESS TRUE
   PREFIX "${CMAKE_BINARY_DIR}"
   SOURCE_DIR "${CMAKE_BINARY_DIR}/xnnpack"

