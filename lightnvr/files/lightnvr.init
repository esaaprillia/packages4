#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/lightnvr
CONF=/etc/lightnvr/lightnvr.ini

start_service() {
        procd_open_instance
        procd_set_param command "$PROG" -c "$CONF"
        procd_set_param respawn
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
}
